# Copy to deploy/staging/.env on the server (never commit .env).
# deploy.sh creates it automatically with a random password if it is missing.

# Database password: long random string, letters and digits only.
POSTGRES_PASSWORD=change-me
# Host port of the API (127.0.0.1 only). Change if 8000 is busy.
API_PORT=8000
# Port for the website on the network.
HTTP_PORT=80
# How long the website caches API responses, seconds (must be > 0).
BSU_API_REVALIDATE_SECONDS=300
# Number of API worker processes.
API_WORKERS=2
