# Copy to .env.local for local development (.env.local is ignored by Git).
# Defaults keep the website on its local data; nothing here is secret.

# local | backend: faculties, departments, staff, programs, news, documents.
BSU_DATA_SOURCE=local
# local | backend: archive pages (/content/{id}); needs BSU_DATA_SOURCE=backend too.
BSU_CONTENT_SOURCE=local
# API root including /api/v1. Server-side only, never exposed to the browser.
# Inside Docker, use the service name (e.g. http://api:8000/api/v1), not localhost.
BSU_API_BASE_URL=http://127.0.0.1:8000/api/v1
